  r2.xyz = -r2.xzw * r2.yyy + r1.xyz;
  r0.z = dot(r2.yz, r2.yz);
  r0.z = 1 + -r0.z;
  r2.w = sqrt(r0.z);
  r0.z = saturate(dot(r3.xyz, r2.yzw));
  r0.z = r0.z * r0.z;
  r0.w = r0.z * r0.z + r0.y;
  r0.w = 1 + r0.w;
  r0.w = 1 / r0.w;
  r0.yz = r0.yz * r0.wz;
  r0.x = r0.y * r0.x;
  r0.x = r0.w * r1.x + r0.x;
  r0.y = r0.z * r0.w;
  o0.xyzw = r0.yyyy * r2.xxxx + r0.xxxx;
  return;
}